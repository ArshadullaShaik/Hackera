// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Hackathon {
  // Internal ID (separate from sourceId)
  id String @id @default(uuid()) @db.Uuid

  // Source tracking
  sourceId       String
  sourcePlatform String

  // Canonical fields
  title                String
  description          String    @default("")
  startsAt             DateTime
  endsAt               DateTime?
  registrationStartsAt DateTime?
  registrationEndsAt   DateTime?

  // Location
  locationType String // "in-person" | "online" | "hybrid"
  locationName String?
  latitude     Float?
  longitude    Float?

  // URLs and metadata
  canonicalUrl String
  imageUrl     String?

  // Raw payload for debugging/future enrichment
  rawSourcePayload Json

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Cross-source deduplication
  duplicateOfId String?     @db.Uuid
  duplicateOf   Hackathon?  @relation("HackathonDuplicates", fields: [duplicateOfId], references: [id])
  duplicates    Hackathon[] @relation("HackathonDuplicates")

  // Composite unique constraint: same event from same source shouldn't be duplicated
  @@unique([sourceId, sourcePlatform])
  @@index([sourcePlatform])
  @@index([startsAt])
  @@index([createdAt])
  @@index([duplicateOfId])
}

model ScrapeRun {
  id            String   @id @default(uuid()) @db.Uuid
  platform      String
  status        String // "completed" | "failed"
  eventsCreated Int      @default(0)
  eventsUpdated Int      @default(0)
  errorMessage  String?
  startedAt     DateTime
  completedAt   DateTime
  createdAt     DateTime @default(now())

  @@index([platform])
  @@index([createdAt])
}
