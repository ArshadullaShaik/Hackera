{
  "name": "hackera",
  "version": "1.0.0",
  "description": "Multi-source hackathon aggregator",
  "homepage": "https://github.com/ArshadullaShaik/Hackera#readme",
  "bugs": {
    "url": "https://github.com/ArshadullaShaik/Hackera/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArshadullaShaik/Hackera.git"
  },
  "license": "ISC",
  "author": "",
  "type": "module",
  "engines": {
    "node": "20.x"
  },
  "main": "dist/src/index.js",
  "scripts": {
    "build": "prisma generate && tsc --project tsconfig.build.json && node scripts/fix-esm-imports.mjs",
    "dev": "node --loader ts-node/esm src/index.ts",
    "dev:next": "next dev --webpack",
    "build:next": "prisma generate && next build",
    "start": "node dist/src/index.js",
    "api": "node dist/src/api/server.js",
    "worker": "node dist/src/queue/scrape.worker.js",
    "scheduler": "node dist/src/queue/scrape.scheduler.js",
    "scheduler:once": "node dist/src/queue/scrape.scheduler.js --once",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@prisma/config": "7.9.1",
    "@prisma/debug": "7.9.1",
    "@prisma/driver-adapter-utils": "7.9.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "axios": "^1.7.7",
    "bullmq": "^5.81.2",
    "cheerio": "^1.0.0-rc.12",
    "dotenv": "^17.4.2",
    "express": "^4.21.0",
    "express-rate-limit": "^8.6.0",
    "ioredis": "^5.11.1",
    "next": "^16.2.12",
    "pg": "^8.22.0",
    "pino": "^9.0.0",
    "pino-pretty": "^11.2.2",
    "playwright": "^1.45.0",
    "prisma": "7.9.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4",
    "vitest": "^4.1.10"
  }
}
