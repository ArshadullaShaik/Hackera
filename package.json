{
  "name": "hackera",
  "version": "1.0.0",
  "description": "Multi-source hackathon aggregator",
  "homepage": "https://github.com/ArshadullaShaik/Hackera#readme",
  "bugs": {
    "url": "https://github.com/ArshadullaShaik/Hackera/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArshadullaShaik/Hackera.git"
  },
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "node --loader ts-node/esm src/index.ts",
    "start": "node dist/index.js",
    "api": "node dist/api/server.js",
    "worker": "node dist/queue/scrape.worker.js",
    "scheduler": "node dist/queue/scrape.scheduler.js",
    "scheduler:once": "node dist/queue/scrape.scheduler.js --once",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/client": "^5.0.0",
    "axios": "^1.7.7",
    "bullmq": "^5.81.2",
    "cheerio": "^1.0.0-rc.12",
    "express": "^4.21.0",
    "express-rate-limit": "^8.6.0",
    "ioredis": "^5.11.1",
    "pino": "^9.0.0",
    "pino-pretty": "^11.2.2",
    "playwright": "^1.45.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "prisma": "^5.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4",
    "vitest": "^4.1.10"
  }
}